# Cloudflare Pages headers
# Next.js build files are content-hashed, so they can be cached for a year
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Open Graph images are regenerated with `npm run og`; cache for a day
/og/*
  Cache-Control: public, max-age=86400

# Blog post images are built without a file extension, so set the type explicitly
/*/blog/*/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400
